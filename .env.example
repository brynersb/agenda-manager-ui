# Keycloak local (realm `bora`, client público `pauta-mkt-ui`). Sem segredos.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/bora
VITE_OIDC_CLIENT_ID=pauta-mkt-ui
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email

# API local. A barra final é obrigatória (o `ky` usa como `prefix`).
VITE_API_BASE_URL=http://localhost:3000/api/v1/

# Aparência (opcional). A escolha da pessoa no menu do usuário prevalece.
# Tema: `soft` (padrão, mais leve) ou `classic` (visual original).
VITE_UI_THEME=soft
# Formulários: `modal` (padrão, janela central) ou `drawer` (painel lateral).
VITE_FORM_PRESENTATION=modal
